# Development template only. Replace every secret before any shared/staging/production use.
ARGENT_ENV=dev
PORT=8080
JDBC_URL=jdbc:postgresql://localhost:5432/argent
DB_USER=argent
DB_PASS=argent
POSTGRES_PASSWORD=argent
REDIS_PASSWORD=argent
REDIS_URL=redis://:argent@127.0.0.1:6379
RABBITMQ_URL=amqp://argent:argent@127.0.0.1:5672
RABBITMQ_PASSWORD=argent
GRAFANA_ADMIN_PASSWORD=argent
JWT_SECRET=replace-with-32-plus-character-secret!!
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
ARGENT_CORS_HOSTS=localhost:3000,127.0.0.1:3000
SEED_MARKET_MAKER=true
SEED_DEMO_FUNDS=true
# Binance public crypto quotes (no API key, internet required); use SIMULATED to run offline.
MARKET_DATA_MODE=BINANCE_PUBLIC
# Optional Binance Spot Testnet only (never a production Binance key). Keep blank unless testing.
BINANCE_SPOT_TESTNET_API_KEY=
BINANCE_SPOT_TESTNET_SECRET=
MARKET_MAKER_PASSWORD=
MM_MAX_QUOTE_NOTIONAL=5000
MM_MAX_INVENTORY_NOTIONAL=10000000
# Optional read-only AI assistant. Groq pricing and limits depend on account plan and model.
# Account context is sent to the configured provider only after a key is added.
ARGENT_AI_API_KEY=
ARGENT_AI_BASE_URL=https://api.groq.com/openai/v1
ARGENT_AI_MODEL=openai/gpt-oss-20b
# Alert when a balance changes by this percent from the first portfolio sample today.
ARGENT_AI_BALANCE_CHANGE_ALERT_PCT=10
# Concentration alert threshold based on ARGENT's position concentration score.
ARGENT_AI_CONCENTRATION_ALERT_PCT=80
